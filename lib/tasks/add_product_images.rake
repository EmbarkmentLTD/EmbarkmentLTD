  'meat' => 'https://images.unsplash.com/photo-1607623814075-e51df1bdc82f?w=400&h=400&fit=crop',
  'other' => 'https://images.unsplash.com/photo-1474979266404-7eaacbcd87c5?w=400&h=400&fit=crop'
}.freeze

# Find the best matching image URL for a product based on its name ONLY
# Uses word boundary matching to prevent "pineapple" matching "apple"
def get_matched_image_url(product)
  name_lower = product.name.downcase
  
  # Priority order: longer keywords first to match "sweet potato" before "potato"
  # Also prioritize compound names and specific varieties
  sorted_keys = PRODUCT_SPECIFIC_IMAGES.keys.sort_by { |k| -k.length }
  
  sorted_keys.each do |keyword|
    # Use word boundary regex to prevent partial matches
    # \b matches word boundaries, so "pineapple" won't match "\bapple\b"
    pattern = /\b#{Regexp.escape(keyword)}\b/i
    
    if name_lower.match?(pattern)
      image_url = PRODUCT_SPECIFIC_IMAGES[keyword]
      puts "  -> Matched '#{keyword}' for '#{product.name}'"
      return image_url
    end
  end
  
  # Fallback to category-based images
  puts "  -> Using category fallback (#{product.category}) for '#{product.name}'"
  get_category_image_url(product.category)
end

def get_category_image_url(category)
  images = PRODUCT_CATEGORY_IMAGES[category] || PRODUCT_CATEGORY_IMAGES['other']
  images.sample
end

def attach_image_to_product(product, image_url)
  require 'open-uri'
  require 'tempfile'
  
  downloaded_image = URI.open(image_url, 
    "User-Agent" => "Mozilla/5.0 (Macintosh; Intel Mac OS X 10_15_7)",
    read_timeout: 15,
    open_timeout: 15
  )
  
  temp_file = Tempfile.new(['product_image', '.jpg'])
  temp_file.binmode
  temp_file.write(downloaded_image.read)
  temp_file.rewind
  
  product.images.attach(
    io: temp_file,
    filename: "#{product.name.parameterize}-#{SecureRandom.hex(4)}.jpg",
    content_type: 'image/jpeg'
  )
  
  temp_file.close
  temp_file.unlink
  
  true
end

namespace :products do
  desc "Add matched images to products without images (matches product name/description)"
  task add_images: :environment do
    products_without_images = Product.left_joins(:images_attachments).where(active_storage_attachments: { id: nil })
    total = products_without_images.count
    
    puts "Found #{total} products without images"
    puts "Images will be matched to product names and descriptions\n"
    
    if total == 0
      puts "All products have images!"
      exit
    end

    success_count = 0
    error_count = 0

    products_without_images.find_each.with_index do |product, index|
      begin
        puts "Processing: #{product.name}"
        image_url = get_matched_image_url(product)
        attach_image_to_product(product, image_url)
        
        success_count += 1
        print "." if success_count % 10 == 0
        
        sleep(0.1)
        
      rescue => e
        error_count += 1
        puts "\nError for #{product.name}: #{e.message}"
      end
      
      if (index + 1) % 50 == 0
        puts "\nProcessed #{index + 1}/#{total} products..."
      end
    end

    puts "\n\nCompleted!"
    puts "Successfully added images: #{success_count}"
    puts "Errors: #{error_count}"
    
    remaining = Product.left_joins(:images_attachments).where(active_storage_attachments: { id: nil }).count
    puts "Products still without images: #{remaining}"
  end

  desc "Replace all product images with matched images (based on product name/description)"
  task replace_images: :environment do
    products = Product.all
    total = products.count
    
    puts "Replacing images for #{total} products with product-matched images..."
    puts "This will DELETE existing images and attach images that match product names/descriptions.\n"
    
    success_count = 0
    error_count = 0

    products.find_each.with_index do |product, index|
      begin
        puts "Processing: #{product.name}"
        product.images.purge if product.images.attached?
        
        image_url = get_matched_image_url(product)
        attach_image_to_product(product, image_url)
        
        success_count += 1
        print "."
        
      rescue => e
        error_count += 1
        puts "\nError for #{product.name}: #{e.message}"
      end
      
      if (index + 1) % 50 == 0
        puts "\nProcessed #{index + 1}/#{total}..."
      end
    end

    puts "\n\nCompleted!"
    puts "Successfully replaced images: #{success_count}"
    puts "Errors: #{error_count}"
  end

  desc "Validate and report products with potential image mismatches"
  task validate_images: :environment do
    products = Product.all
    total = products.count
    
    puts "Analyzing #{total} products for image-to-description matches...\n\n"
    
    matched_products = []
    unmatched_products = []
    no_image_products = []
    
    # Sort keys by length descending for consistent matching
    sorted_keys = PRODUCT_SPECIFIC_IMAGES.keys.sort_by { |k| -k.length }
    
    products.find_each do |product|
      name_lower = product.name.downcase
      
      # Find matching keyword using word boundaries (same logic as get_matched_image_url)
      matched_keyword = sorted_keys.find do |keyword|
        pattern = /\b#{Regexp.escape(keyword)}\b/i
        name_lower.match?(pattern)
      end
      
      if !product.images.attached?
        no_image_products << [product, matched_keyword]
      elsif matched_keyword
        matched_products << [product, matched_keyword]
      else
        unmatched_products << product
      end
    end
    
    puts "=" * 60
    puts "IMAGE VALIDATION REPORT"
    puts "=" * 60
    
    puts "\n✅ MATCHED PRODUCTS (#{matched_products.count}):"
    puts "-" * 40
    matched_products.each do |product, keyword|
      puts "  • #{product.name} -> matched '#{keyword}'"
    end
    
    puts "\n⚠️  UNMATCHED PRODUCTS (using category fallback) (#{unmatched_products.count}):"
    puts "-" * 40
    unmatched_products.each do |p|
      puts "  • #{p.name} (category: #{p.category})"
      puts "    Description: #{p.description.to_s[0..80]}..."
    end
    
    puts "\n❌ PRODUCTS WITHOUT IMAGES (#{no_image_products.count}):"
    puts "-" * 40
    no_image_products.each do |product, keyword|
      if keyword
        puts "  • #{product.name} (could match '#{keyword}')"
      else
        puts "  • #{product.name}"
      end
    end
    
    puts "\n" + "=" * 60
    puts "SUMMARY"
    puts "=" * 60
    puts "Total products: #{total}"
    puts "Matched images: #{matched_products.count} (#{(matched_products.count.to_f / total * 100).round(1)}%)"
    puts "Category fallback: #{unmatched_products.count} (#{(unmatched_products.count.to_f / total * 100).round(1)}%)"
    puts "Missing images: #{no_image_products.count}"
    
    if unmatched_products.any?
      puts "\nTo add specific matches for unmatched products, edit:"
      puts "lib/tasks/add_product_images.rake"
      puts "Add keywords to PRODUCT_SPECIFIC_IMAGES hash"
    end
    
    if no_image_products.any?
      puts "\nTo add images to products without images, run:"
      puts "rake products:add_images"
    end
  end

  desc "Fix specific products with wrong images (replace with matched images)"
  task fix_mismatched: :environment do
    products = Product.all
    fixed_count = 0
    
    puts "Finding and fixing products with potentially mismatched images...\n\n"
    
    products.find_each do |product|
      name_lower = product.name.downcase
      description_lower = product.description.to_s.downcase
      combined_text = "#{name_lower} #{description_lower}"
      
      # Check if we have a specific match available
      has_specific_match = PRODUCT_SPECIFIC_IMAGES.keys.any? { |keyword| combined_text.include?(keyword) }
      
      next unless has_specific_match && product.images.attached?
      
      puts "Fixing: #{product.name}"
      
      begin
        product.images.purge
        image_url = get_matched_image_url(product)
        attach_image_to_product(product, image_url)
        fixed_count += 1
        puts "  ✓ Updated with matched image"
      rescue => e
        puts "  ✗ Error: #{e.message}"
      end
    end
    
    puts "\n" + "=" * 40
    puts "Fixed #{fixed_count} products with matched images"
  end
end
