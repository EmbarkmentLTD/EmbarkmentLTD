<div class="min-h-screen bg-gradient-to-br from-green-50 to-emerald-100 py-12 px-4 sm:px-6 lg:px-8">
    <div class="max-w-md mx-auto">
        <div class="text-center mb-8">
            <%= link_to root_path, class: "inline-flex items-center space-x-3" do %>
            <%= image_tag "logo/logo_no_glow_or_shadow.png", alt: "Embarkment Logo", class: "inline-block h-10 w-auto" %>
            <% end %>
            <h2 class="mt-6 text-2xl font-bold text-gray-900">Verify Sign In</h2>
            <p class="mt-2 text-sm text-gray-600">A 6-digit sign-in code has been sent to your email. If your account is not verified yet, we will send the verification code after sign in.</p>
        </div>

        <div class="bg-white rounded-2xl shadow-lg p-8">
            <% if flash[:alert] %>
            <div class="mb-6 p-4 bg-red-50 border border-red-200 rounded-lg">
                <p class="text-sm text-red-700"><%= flash[:alert] %></p>
            </div>
            <% end %>
            <% if flash[:notice] %>
            <div class="mb-6 p-4 bg-green-50 border border-green-200 rounded-lg">
                <p class="text-sm text-green-700"><%= flash[:notice] %></p>
            </div>
            <% end %>

            <%= form_with url: sign_in_verification_path, method: :post, class: "space-y-6" do %>
            <div>
                <label class="block text-center text-sm font-medium text-gray-700 mb-2">
                    6-Digit Verification Code
                </label>
                <div class="flex justify-center">
                    <input type="text" name="sign_in_code" maxlength="6" pattern="\d{6}" required
                           class="text-center text-3xl font-bold tracking-widest px-4 py-3 w-48 border-2 border-gray-300 rounded-lg focus:ring-2 focus:ring-green-500 focus:border-green-500"
                           placeholder="000000" autocomplete="one-time-code" autofocus>
                </div>
                <p class="text-xs text-gray-500 mt-2 text-center">
                    Check your email inbox. This code expires in 10 minutes.
                </p>
            </div>
            <button type="submit" class="w-full flex justify-center py-3 px-4 border border-transparent rounded-lg shadow-sm text-sm font-medium text-white bg-green-600 hover:bg-green-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-green-500 transition-colors cursor-pointer">
                Verify &amp; Sign In
            </button>
            <% end %>

            <div class="mt-6 text-center">
                <p class="text-sm text-gray-500 mb-3">Didn't receive the sign-in code?</p>
                <%= button_to "Resend Code", resend_sign_in_verification_path, method: :post,
                    class: "text-sm text-green-600 hover:text-green-700 font-medium bg-transparent border-0 cursor-pointer underline" %>
            </div>

            <div class="mt-4 text-center">
                <%= link_to "Back to sign in", new_user_session_path, class: "text-sm text-gray-500 hover:text-gray-700" %>
            </div>
        </div>
    </div>
</div>
